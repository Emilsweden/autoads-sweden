# ── Lead-hantering ────────────────────────────────────────────────
# Välj leverantör: "resend" eller "formspree".
# Lämnas den tom loggas leads bara till serverkonsolen (bra under utveckling).
LEAD_PROVIDER=

# ── Resend (LEAD_PROVIDER=resend) ─────────────────────────────────
# Skapa API-nyckel på https://resend.com/api-keys
RESEND_API_KEY=
# Valfritt: lägg varje lead som kontakt i en Resend-audience.
# Skapa en audience på https://resend.com/audiences och klistra in dess ID.
RESEND_AUDIENCE_ID=
# Valfritt: skicka en notis-mejl till dig själv för varje ny lead.
# LEAD_FROM_EMAIL måste vara en verifierad avsändare/domän i Resend.
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# ── Formspree (LEAD_PROVIDER=formspree) ───────────────────────────
# Skapa ett formulär på https://formspree.io och klistra in ID:t (t.ex. "mqkvabcd").
FORMSPREE_FORM_ID=

# ── Sajt ──────────────────────────────────────────────────────────
# Används för canonical-URL och Open Graph. Ändra till din riktiga domän.
NEXT_PUBLIC_SITE_URL=https://lyfta.se
